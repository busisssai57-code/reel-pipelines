# BTA — AI TikTok Live streamer
# Copy this file to .env and fill in the two required values at the top.
#   cp .env.example .env

# ============================================================
# REQUIRED
# ============================================================

# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The TikTok account whose live stream you want to read chat from.
# Accepts @handle, handle, or a full tiktok.com URL.
TIKTOK_HANDLE=@yourhandle


# ============================================================
# VOICE & PERSONALITY
# ============================================================

# Leave GEMINI_MODEL blank to auto-select the first working Live model from
# GEMINI_MODEL_FALLBACKS. Set it explicitly to pin one.
GEMINI_MODEL=
# GEMINI_MODEL_FALLBACKS=model-a,model-b

# Prebuilt voices include: Puck, Charon, Kore, Fenrir, Aoede, Leda, Orus, Zephyr
GEMINI_VOICE=Puck
GEMINI_LANGUAGE=en-US
GEMINI_TEMPERATURE=1.0

# What your streamer is called, and how it should behave.
PERSONA_NAME=Nova
# PERSONA_EXTRA=You are obsessed with retro games and you never swear.
# PERSONA_FILE=persona.txt

# Native-audio-model extras. Leave false unless your chosen model supports them.
#   affective dialog = the voice reacts to emotional tone
#   proactivity      = the model may choose to stay silent
GEMINI_AFFECTIVE_DIALOG=false
GEMINI_PROACTIVITY=false


# ============================================================
# AUDIO OUTPUT
# ============================================================

# device = play through a sound card (route this into OBS)
# wav    = write to a file instead (testing)
# null   = discard
AUDIO_SINK=device

# Output device name or index. Blank = system default.
# Point this at a virtual cable so OBS can capture it:
#   Windows  "CABLE Input (VB-Audio Virtual Cable)"
#   macOS    "BlackHole 2ch"
#   Linux    a PulseAudio/PipeWire null sink
# List what is available with: python run.py --list-devices
AUDIO_DEVICE=

AUDIO_WAV_PATH=out/stream_audio.wav
AUDIO_FRAME_MS=20
AUDIO_GAIN=1.0

# Raise this if the avatar's lips move slightly BEFORE the voice is heard.
AUDIO_LIPSYNC_DELAY_MS=0


# ============================================================
# VTUBE STUDIO
# ============================================================

VTS_ENABLED=true
VTS_HOST=127.0.0.1
VTS_PORT=8001
VTS_PLUGIN_NAME=BTA Streamer
VTS_PLUGIN_DEVELOPER=BTA

# Where the API token is cached, so you only approve the popup once.
VTS_TOKEN_FILE=.vts_token

# Parameters driven by the lip-sync envelope. Change these if your model uses
# custom parameter names. Set VTS_MOUTH_FORM_PARAM= (blank) to drive only the
# mouth-open parameter.
VTS_MOUTH_OPEN_PARAM=MouthOpen
VTS_MOUTH_FORM_PARAM=MouthSmile

VTS_INJECT_FPS=60
VTS_WEIGHT=1.0

# faceFound=false lets VTube Studio keep its own tracking for everything we do
# not explicitly set. Set true if you have no webcam tracking at all.
VTS_FACE_FOUND=false

# true = refuse to run if VTube Studio is unreachable (default: keep streaming
# audio and retry in the background).
VTS_REQUIRED=false


# ============================================================
# CHAT HANDLING
# ============================================================

# How many chat messages get bundled into one spoken response.
DIRECTOR_MAX_BATCH=4
DIRECTOR_MAX_MESSAGE_CHARS=180
DIRECTOR_QUEUE_SIZE=500

# Seconds before the same viewer can trigger another response.
DIRECTOR_USER_COOLDOWN=8

# Window for suppressing identical repeated messages.
DIRECTOR_DEDUPE_WINDOW=60

# Seconds of silence before the streamer says something unprompted.
DIRECTOR_IDLE_PROMPT_AFTER=45
# DIRECTOR_IDLE_PROMPTS=Ask chat what they are doing today,Tell a short joke

# Comma-separated words that get a message dropped entirely.
DIRECTOR_BLOCKED_WORDS=

DIRECTOR_STRIP_URLS=true
DIRECTOR_GREET_GIFTS=true
DIRECTOR_GREET_FOLLOWS=true


# ============================================================
# PRODUCT FULFILLMENT  (see fulfillment/README.md)
# ============================================================

# Off by default. Turn on to capture orders from live activity.
COMMERCE_ENABLED=false

# Starting inventory, as sku:count pairs.
# COMMERCE_STOCK=tee-blk-l:40,mug:12

# Prices in cents, used for revenue reporting only.
# COMMERCE_PRICES=tee-blk-l:2500,mug:1200

# How the streamer says a sku out loud.
# COMMERCE_SKU_NAMES=tee-blk-l:black tee,mug:enamel mug

# Which TikTok gift claims which product, as GiftName:sku. Matched
# case-insensitively. A gift that is not listed here NEVER places an order —
# a SKU is never guessed. Note a gift carries no size or variant, so map each
# gift to one specific, fully-specified sku.
# COMMERCE_GIFT_SKUS=Galaxy:tee-blk-l,Rose:sticker-01

# A gift is already paid for (TikTok settled it), so gift orders are fulfilled
# immediately. Set false to leave them RESERVED for manual confirmation —
# but then something must fulfil or cancel them, or the stock is held forever.
COMMERCE_AUTO_FULFILL_GIFTS=true

# Whether ending a broadcast releases reserved stock. false = a buyer whose
# stream dropped keeps their unit. This is a policy decision, so it is explicit.
COMMERCE_RELEASE_HOLDS_ON_END=false

# Whether the streamer talks about orders out loud.
COMMERCE_ANNOUNCE_ORDERS=true

# Groups orders under one broadcast. Blank = generated per run.
COMMERCE_SESSION_ID=


# ============================================================
# TIKTOK CONNECTION
# ============================================================

TIKTOK_RECONNECT_DELAY=10
TIKTOK_RETRY_WHEN_OFFLINE=true

# Only needed for rooms that require a logged-in viewer. This is a credential —
# treat it like a password and never commit it.
TIKTOK_SESSION_ID=


# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO
