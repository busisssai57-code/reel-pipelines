# Copy to .env and fill in. All services here are free.

# ---- Footage / image APIs (free, register for a key) ----
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Archive.org needs no key for search/download.

# ---- Discord approval bot ----
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# ---- Local qwen endpoint (OpenAI-compatible). Default = Ollama. ----
# Run:  ollama pull qwen2.5:7b-instruct   &&   ollama serve
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_API_KEY=ollama
QWEN_MODEL=qwen2.5:7b-instruct

# ---- Paths / behavior ----
DRAFTS_PER_PIPELINE=21
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ---- Hunyuan Video via ComfyUI ----
COMFY_URL=http://127.0.0.1:8188
COMFY_ROOT=D:\ComfyUI
COMFY_OUTPUT=D:\ComfyUI\output
HUNYUAN_WORKFLOW=D:\reel-pipelines\workflows\hunyuan_t2v_native_api.json
HUNYUAN_MODEL=hunyuan_video_t2v_720p_bf16.safetensors
HUNYUAN_VAE=hunyuan_video_vae_bf16.safetensors
HUNYUAN_CLIP=clip_l.safetensors
HUNYUAN_LLM=llava_llama3_fp8_scaled.safetensors
LIPSYNC_MODEL=latentsync

# ---- Auto-poster ----
# local_manifest is production-safe and writes logs/autopost-manifest.jsonl.
# webhook POSTs the publish payload to AUTOPOST_WEBHOOK_URL.
AUTOPOST_MODE=local_manifest
AUTOPOST_WEBHOOK_URL=
AUTOPOST_DRY_RUN=0

# ---- API security (set before exposing through a tunnel/LAN) ----
REEL_API_KEY=
CORS_ORIGIN=*
